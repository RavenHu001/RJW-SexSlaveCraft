<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 无阵营动物直接驯服；玩家动物按原版优先级完整完成一个已勾选且符合条件的训练项目。
       地图选取与实际同格施放分别由自定义 Verb 检查；原版两秒预热完成后才结算一天冷却。
       两个分支共用读条、训导社交符号与说话波纹；不发动物技能或特化经验，也不触发工作后事件。 -->
  <AbilityDef>
    <defName>SSC_PetDogTame</defName>
    <label>定向驯导</label>
    <description>终极宠物狗可选择同地图上存活、有意识、没有精神状态的无阵营或玩家阵营动物，走到其所在格后进行 2 秒训导，期间显示读条、训导气泡和连续说话波纹，目标暂停行动。普通睡眠可被唤醒，意识合格的倒地动物也可选择，树精除外。无阵营动物须符合原版可驯服条件，完成后直接驯服为玩家阵营。玩家动物须有已勾选、满足原版前置及种族/体型条件且仍需训练的项目；完成时按原版优先级选择一个项目并补至完成，已学项目衰减后也可补满，不改变动物主人。不需要食物、额外材料或成功率判定，不受普通训练间隔限制。两个分支共用 1 游戏内天冷却；取消、目标失效或没有有效训练项目不消耗新冷却。征召与未征召时均可使用，不增加动物技能或特化经验，也不触发工作后事件。</description>
    <abilityClass>SexSlaveCraft.Ability_PetDogTame</abilityClass>
    <iconPath>UI/Icons/Trainables/Tameness</iconPath>
    <jobDef>SSC_Job_PetDogTame</jobDef>
    <targetRequired>true</targetRequired>
    <canUseAoeToGetTargets>false</canUseAoeToGetTargets>
    <hostile>false</hostile>
    <showPsycastEffects>false</showPsycastEffects>
    <stunTargetWhileCasting>true</stunTargetWhileCasting>
    <showCastingProgressBar>true</showCastingProgressBar>
    <warmupMoteSocialSymbol>Things/Mote/SpeechSymbols/TrainAttempt</warmupMoteSocialSymbol>
    <warmupEffecter>SSC_PetDogTameWarmup</warmupEffecter>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <showWhenDrafted>true</showWhenDrafted>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <verbProperties>
      <verbClass>SexSlaveCraft.Verb_PetDogTame</verbClass>
      <warmupTime>2</warmupTime>
      <range>0</range>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetHumans>false</canTargetHumans>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <neverTargetIncapacitated>false</neverTargetIncapacitated>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="SexSlaveCraft.CompProperties_AbilityPetDogTame" />
    </comps>
  </AbilityDef>
</Defs>
