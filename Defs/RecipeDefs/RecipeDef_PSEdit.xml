<Defs>

  <RecipeDef Class="SexSlaveCraft.RecipeDef_PSTag">
    <defName>SSC_PSEdit_Bus_Final</defName>
    <label>性奴特化（终极公交车）</label>
    <description>将已经完成公交车特化的人格凝胶进一步塑形为终极公交车状态。该配方只接受公交车特化达到 100% 的材料，并与普通公交车状态互斥。</description>
    <jobString>正在塑造终极公交车人格...</jobString>
    <workAmount>3500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_Sculpt</soundWorking>

    <hediffToAdd>SSC_Hediff_Bus_Final</hediffToAdd>
    <severity>1.00</severity>
    <filterIfTagExists>true</filterIfTagExists>
    <requireBusSpecializationComplete>true</requireBusSpecializationComplete>
    <exclusiveTags>
      <li>SSC_Hediff_Bus_Final</li>
    </exclusiveTags>

    <recipeUsers>
      <li>TableSculpting</li>
    </recipeUsers>

    <researchPrerequisite>SSC_RES_PublicUse</researchPrerequisite>

    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>SSC_PersonalitySlime</li>
            <li>SSC_PersonalitySlime_PLUS</li>
            <li>SSC_PersonalitySlime_ULTRA</li>
            <li>SSC_PersonalitySlime_PLUS_ULTRA</li>
            <li>SSC_PersonalitySlime_Edited</li>
            <li>SSC_PersonalitySlime_PLUS_Edited</li>
            <li>SSC_PersonalitySlime_ULTRA_Edited</li>
            <li>SSC_PersonalitySlime_PLUS_ULTRA_Edited</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>

    <fixedIngredientFilter>
      <thingDefs>
        <li>SSC_PersonalitySlime</li>
        <li>SSC_PersonalitySlime_PLUS</li>
        <li>SSC_PersonalitySlime_ULTRA</li>
        <li>SSC_PersonalitySlime_PLUS_ULTRA</li>
        <li>SSC_PersonalitySlime_Edited</li>
        <li>SSC_PersonalitySlime_PLUS_Edited</li>
        <li>SSC_PersonalitySlime_ULTRA_Edited</li>
        <li>SSC_PersonalitySlime_PLUS_ULTRA_Edited</li>
      </thingDefs>
    </fixedIngredientFilter>

    <workerClass>SexSlaveCraft.Recipe_PSTagWorker</workerClass>
  </RecipeDef>

