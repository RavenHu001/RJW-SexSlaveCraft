  <RecipeDef Class="SexSlaveCraft.RecipeDef_PSTag">
    <defName>SSC_PSEdit_PetCat_Final</defName>
    <label>性奴特化（终极宠物猫）</label>
    <description>将当前培养方向为宠物猫、普通培养已完成且带有宠物猫基础状态的人格凝胶，加工为终极宠物猫人格。原料不能已有猫、狗或兔终极成果。植入后获得永久移动速度与近战闪避加成，并可继续亲昵实际绑定的主人；并获得“安抚共鸣”，使其他玩家阵营人形角色从精神状态中恢复，或给予短暂的心情与工作速度鼓舞。</description>
    <jobString>正在塑造终极宠物猫人格...</jobString>
    <workAmount>3500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Sculpt</effectWorking>
    <soundWorking>Recipe_Sculpt</soundWorking>

    <hediffToAdd>SSC_Hediff_PetCat_Final</hediffToAdd>
    <severity>1.00</severity>
    <filterIfTagExists>true</filterIfTagExists>
    <requireSpecializationType>PetCat</requireSpecializationType>
    <requireSpecializationComplete>true</requireSpecializationComplete>
    <!-- 猫、狗、兔共用终极互斥组，奶牛等组外成果不在此列表。
         公共资格先拒绝已有任意宠物终极的来源；工作者只清理产物副本。
         普通标签是原料的必要资格，复制后另行移除，不加入此互斥列表。 -->
    <exclusiveTags>
      <li>SSC_Hediff_PetCat_Final</li>
      <li>SSC_Hediff_PetDog_Final</li>
      <li>SSC_Hediff_PetRabbit_Final</li>
