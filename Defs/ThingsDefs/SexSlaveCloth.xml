<Defs>
<ThingDef ParentName="ApparelBase">
    <defName>Apparel_BulletproofSuit</defName>
    <label>简易堕落维持装置</label>
    <description>基础款式的的堕落维持装置，用于保持少女的堕落程度。一定程度上增加堕落值的获取</description>
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <tradeability>All</tradeability>
    <relicChance>1</relicChance>
    <techLevel>Industrial</techLevel>

    <!-- 地面/库存贴图 -->
    <graphicData>
      <texPath>Things/Apparel/SexSlaveClothes/base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>

    <!-- 穿戴参数 -->
    <apparel>
      <layers>
        <li>Shell</li>
      </layers>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/SexSlaveClothes/base</wornGraphicPath>
      <gender>Female</gender>
      <countsAsClothingForNudity>true</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
    </apparel>

    <!-- 自定义 Comp -->
    <comps>
      <li Class="SexSlaveCraft.CompProperties_CorruptionModifier">
        <corruptionMultiplier>1.1</corruptionMultiplier>
        <minCorruptionLevel>0.3</minCorruptionLevel>
      </li>
    </comps>

    <!-- 制作材料 -->
    <costList>
	    <ComponentIndustrial>5</ComponentIndustrial>
      <Cloth>100</Cloth>
      <Steel>100</Steel>
    </costList>

    <!-- RecipeMaker：制作半成品 -->
    <recipeMaker>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
    </recipeMaker>

    <!-- 基础属性 -->
    <statBases>
      <WorkToMake>200</WorkToMake>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>1</Mass>
      <Flammability>0.5</Flammability>
      <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <Insulation_Cold>10</Insulation_Cold>
      <EquipDelay>5</EquipDelay>
    </statBases>

    <!-- 穿戴加成 -->

    <equippedStatOffsets>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.1</SlaveSuppressionOffset>
      <MoveSpeed>-0.2</MoveSpeed>
    </equippedStatOffsets>

  </ThingDef>
</Defs>
