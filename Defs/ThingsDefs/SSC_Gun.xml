  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_PNA_Low</defName>
    <label>普通纳米机械子弹</label>
    <graphicData>
      <texPath>Things/Projectile/ChargeLanceShot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <color>(200, 130, 255)</color> <drawSize>1.0</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Damage_PNA_Damage_LowTier</damageDef>
      <damageAmountBase>2</damageAmountBase> <speed>55</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>Gun_PNA_Low</defName>
    <label>简易PNA发射器</label>
    <description>一把PNA发射器，发射的PNA会侵入敌军的装甲，渗透到敌军体内，命中一定次数使其持续高潮而倒地，如果发射的对象是性奴那么就会有增益的效果。</description>
    <graphicData>
      <texPath>Things/Item/Equipment/Gun_PNA_Low</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Autopistol</soundInteract>
    
    <statBases>
      <WorkToMake>10000</WorkToMake>
      <Mass>2.5</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.60</AccuracyShort>
      <AccuracyMedium>0.40</AccuracyMedium>
      <AccuracyLong>0.20</AccuracyLong>
      <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
    </statBases>

    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Purple_Aphrodisiac_Nanofluid>10</Purple_Aphrodisiac_Nanofluid>
    </costList>

    <recipeMaker>
      <researchPrerequisite>Machining</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
    </recipeMaker>

    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_PNA_Low</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>22.9</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_Autopistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

</Defs>
