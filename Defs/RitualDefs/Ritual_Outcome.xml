            <li>(5,  0.15)</li>
            <li>(10, 0.20)</li> </points>
        </curve>
      </li>
      
      <li Class="RimWorld.RitualOutcomeComp_RoomStat">
        <label>房间氛围</label>
        <statDef>Impressiveness</statDef>
        <curve>
          <points>
            <li>(0,   0.0)</li>
            <li>(50,  0.05)</li>
            <li>(120, 0.10)</li> </points>
        </curve>
      </li>
      
      <li Class="SexSlaveCraft.RitualOutcomeComp_GenitalDifference">
