<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 训导官弱化套：与主人原套完全独立的 8 个 Def，不覆盖、不改写 SSC_Training_*。
       弱值均为整数，按维护者确认的 K=0.5 换算：四舍五入到整数，非零基准保底绝对值 1。
       旧模式弱社交直接写入运行后的值（+3／+8），不再由 SSCThoughtBootstrap 二次改写。
       描述中的动作统一用“调教”，“训导”只用于训导官这一角色名。 -->

  <ThoughtDef>
    <defName>SSC_TrainerTraining_MoodDynamic</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>训导官调教余韵 (反感)</label>
        <description>同样受人支配的训导官却来调教我，那种不适感挥之不去。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>训导官调教余韵 (动摇)</label>
        <description>明明身份相近，刚才的调教似乎并没有那么难以接受……</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
      <li>
        <label>训导官调教余韵 (适应)</label>
        <description>我好像渐渐习惯了训导官的调教方式。</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
      <li>
        <label>训导官调教余韵 (沉沦)</label>
        <description>一回想起那名训导官的调教，脑子就有些发昏……</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>SSC_TrainerTraining_OpinionDynamic</defName>
    <thoughtClass>SexSlaveCraft.Thought_MemoryTrainerTraining</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>40</stackLimit>
    <stackLimitForSameOtherPawn>40</stackLimitForSameOtherPawn>
    <showBubble>true</showBubble>
    <stages>
      <li>
        <label>训导官调教记忆 (反感)</label>
        <description>同样受人支配的{0}却来调教我，让我难以接受。好感变化为{1}。</description>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
      <li>
        <label>训导官调教记忆 (动摇)</label>
        <description>明明身份相近，我却开始接受训导官{0}的调教。好感变化为{1}。</description>
        <baseOpinionOffset>1</baseOpinionOffset>
      </li>
      <li>
        <label>训导官调教记忆 (适应)</label>
        <description>我逐渐习惯了训导官{0}的调教。好感变化为{1}。</description>
        <baseOpinionOffset>4</baseOpinionOffset>
      </li>
      <li>
        <label>训导官调教记忆 (沉沦)</label>
        <description>那次经历让我越来越依赖训导官{0}的调教。好感变化为{1}。</description>
        <baseOpinionOffset>8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>SSC_TrainerTraining_Mood_Lvl1</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>训导官调教余韵 (厌恶)</label>
        <description>被身份相近的训导官这样对待，我实在反胃。</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>SSC_TrainerTraining_Mood_Lvl2</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>训导官调教余韵 (迷茫)</label>
        <description>训导官的调教并不让人难受，这反而让我不知所措……</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>SSC_TrainerTraining_Mood_Lvl3</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>训导官调教余韵 (极乐)</label>
        <description>光是回想训导官的手法，脑子就一片空白了……</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>SSC_TrainerTraining_Social_Lvl1</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>训导官调教记忆 (反感)</label>
        <description>那个训导官凭什么那样对待我，我不会轻易忘记。</description>
        <baseOpinionOffset>-10</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>SSC_TrainerTraining_Social_Lvl2</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>15</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>训导官调教记忆 (适应)</label>
        <description>被训导官那样对待，我好像也没有那么抗拒了……</description>
        <baseOpinionOffset>3</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>SSC_TrainerTraining_Social_Lvl3</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>30</durationDays>
    <stackLimit>10</stackLimit>
    <stages>
      <li>
        <label>训导官调教记忆 (沉沦)</label>
        <description>我好像越来越期待那位训导官的调教了……</description>
        <baseOpinionOffset>8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
