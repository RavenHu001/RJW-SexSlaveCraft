<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 严重度仅用于派生阶段；实际进度由训练组件保存，0.01 下限不构成经验。 -->
  <HediffDef>
    <defName>SSC_Hediff_Combatant</defName>
    <label>战斗员培养</label>
    <description>正在培养通用战斗能力。20% 起获得基础收益，50% 起获得熟练收益及常态减伤；精神崩溃临界值的降低在日常也生效。射击精度和近战命中的加成作用于原始评分，并非最终概率的百分点。普通培养完成后保留熟练收益，不授予特殊能力。</description>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <makesSickThought>false</makesSickThought>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>战斗员培养中</label>
      </li>
      <li>
        <minSeverity>0.20</minSeverity>
        <label>基础战斗员</label>
        <statOffsets>
          <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
          <MeleeHitChance>2</MeleeHitChance>
          <MentalBreakThreshold>-0.02</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <AimingDelayFactor>0.95</AimingDelayFactor>
          <MeleeCooldownFactor>0.95</MeleeCooldownFactor>
          <IncomingDamageFactor>1</IncomingDamageFactor>
        </statFactors>
      </li>
      <!-- 写入完整熟练收益，替换基础阶段；普通完成仍停留在这一阶段。 -->
      <li>
        <minSeverity>0.50</minSeverity>
        <label>熟练战斗员</label>
        <statOffsets>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
          <MeleeHitChance>4</MeleeHitChance>
          <MentalBreakThreshold>-0.04</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <AimingDelayFactor>0.90</AimingDelayFactor>
          <MeleeCooldownFactor>0.90</MeleeCooldownFactor>
          <IncomingDamageFactor>0.90</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <!-- 终极成果随人格永久保存，并授予战斗超频。 -->
  <HediffDef>
    <defName>SSC_Hediff_Combatant_Final</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>终极战斗员</label>
    <description>人格凝胶加工并植入后获得的永久战斗特化。提高射击与近战命中原始评分，缩短瞄准和近战冷却，降低日常精神崩溃临界值，承伤乘以 0.80。替换普通战斗员效果，切换培养方向、解绑或退阶后仍保留；人格抽取时随人格离开原身体。授予仅征召时可用的“战斗超频”：六项战斗强化持续 1 游戏小时，冷却 4 游戏小时。</description>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <makesSickThought>false</makesSickThought>
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_GiveAbility">
        <abilityDef>SSC_CombatOverdrive</abilityDef>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
          <MeleeHitChance>6</MeleeHitChance>
          <MentalBreakThreshold>-0.06</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <AimingDelayFactor>0.85</AimingDelayFactor>
          <MeleeCooldownFactor>0.85</MeleeCooldownFactor>
          <IncomingDamageFactor>0.80</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>SSC_Hediff_CombatOverdrive</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>战斗超频</label>
    <description>终极战斗员的短时强化：近战伤害 ×1.30、近战冷却 ×0.75、远程冷却 ×0.80、承伤 ×0.75、移动速度 ×1.25、疼痛 ×0.50。持续 1 游戏小时；解除征召不取消，抽取或替换人格时清除，不随人格迁移。</description>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <makesSickThought>false</makesSickThought>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.50</painFactor>
        <statFactors>
          <MeleeDamageFactor>1.30</MeleeDamageFactor>
          <MeleeCooldownFactor>0.75</MeleeCooldownFactor>
          <RangedCooldownFactor>0.80</RangedCooldownFactor>
          <IncomingDamageFactor>0.75</IncomingDamageFactor>
          <MoveSpeed>1.25</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
