<Defs>
<HediffDef ParentName="AddictionBase">
    <defName>PNA_Addiction</defName>
    <label>紫色纳米液体成瘾</label>
    <description>神经系统已对紫色纳米流体产生依赖，性欲持续增强。戒断时催情更强，操控能力下降，性脆弱度上升，并产生强烈的负面情绪。成瘾随时间逐渐消退，完全停止输入后，完整戒除约需10天。再次服用会加深成瘾并缓解戒断；末期负荷下的输入会进一步加深已有成瘾。该状态仅属于当前身体，不随人格迁移，也不由克隆体继承。</description>
    <hediffClass>Hediff_Addiction</hediffClass>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <chemicalNeed>Need_PNA</chemicalNeed>
    <initialSeverity>1</initialSeverity>
    <comps>
      <!-- 完整沿用原版恢复组件、计时与进度显示，不设负荷或戒断恢复门槛。 -->
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.1</severityPerDay>
        <showDaysToRecover>true</showDaysToRecover>
      </li>
    </comps>

    <stages>
      <li>
        <!-- 与原版成瘾一样，普通档不加阶段标签，括号百分比是已恢复进度。 -->
        <statFactors>
          <SexFrequency>1.25</SexFrequency>
        </statFactors>
      </li>
      <li>
        <label>戒断中</label>
        <!-- 戒断沿原版化学需求选档；性脆弱度为 RJW 属性偏移，不改变战斗承伤。 -->
        <statFactors>
          <SexFrequency>1.75</SexFrequency>
        </statFactors>
        <!-- 使用原版能力乘算，随其他来源正常叠加；仅戒断档降低操控。 -->
        <capMods><li><capacity>Manipulation</capacity><postFactor>0.85</postFactor></li></capMods>
        <statOffsets><Vulnerability>0.30</Vulnerability></statOffsets>
      </li>
    </stages>
    
  </HediffDef>
<ThoughtDef>
    <defName>PNA_Withdrawal_Thought</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>PNA_Addiction</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    
    <stages>
      <li>
        <visible>false</visible>
      </li>
      
      <li>
        <label>纳米流体戒断</label>
        <description>这种空虚感快把我逼疯了！给我那个紫色的水！</description>
        <baseMoodEffect>-18</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
