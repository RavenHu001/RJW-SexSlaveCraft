<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 第二步第一批测试初值：严重度即累计经验，零经验也保留；各阶段是总加成。 -->
  <HediffDef>
    <defName>SSC_Hediff_MasterProgression</defName>
    <label>主人阶段</label>
    <description>与人格一同积累的主人成长。仅在主人身份下提供加成。</description>
    <hediffClass>SexSlaveCraft.Hediff_MasterProgression</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <!-- 经验 0 也是有效基础记录；C# 覆盖零严重度自动移除，最大值同时作为经验上限。 -->
    <initialSeverity>0</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>100</maxSeverity>
    <stages>
      <!-- 每个 minSeverity 是累计经验阈值；属性是本阶段总值，不叠加前面的阶段。 -->
      <li>
        <label>第 1 阶段</label>
        <minSeverity>0</minSeverity>
        <capMods>
          <!-- 意识与操控使用百分点偏移；社交采用乘法，自然愈合沿用原版伤口恢复机制。 -->
          <li><capacity>Consciousness</capacity><offset>0.10</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.05</offset></li>
        </capMods>
        <statFactors><SocialImpact>1.05</SocialImpact></statFactors>
        <naturalHealingFactor>1.00</naturalHealingFactor>
      </li>
      <li>
        <label>第 2 阶段</label>
        <minSeverity>12</minSeverity>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.20</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.10</offset></li>
        </capMods>
        <statFactors><SocialImpact>1.10</SocialImpact></statFactors>
        <naturalHealingFactor>1.10</naturalHealingFactor>
      </li>
      <li>
        <label>第 3 阶段</label>
        <minSeverity>40</minSeverity>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.30</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.20</offset></li>
        </capMods>
        <statFactors><SocialImpact>1.15</SocialImpact></statFactors>
        <naturalHealingFactor>1.20</naturalHealingFactor>
      </li>
      <!-- 最终意识和操控自身超过性奴锁链对应加成，不依赖绑定共振补足。 -->
      <li>
        <label>第 4 阶段</label>
        <minSeverity>100</minSeverity>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.40</offset></li>
          <li><capacity>Manipulation</capacity><offset>0.30</offset></li>
        </capMods>
        <statFactors><SocialImpact>1.20</SocialImpact></statFactors>
        <naturalHealingFactor>1.30</naturalHealingFactor>
      </li>
    </stages>
  </HediffDef>
</Defs>
