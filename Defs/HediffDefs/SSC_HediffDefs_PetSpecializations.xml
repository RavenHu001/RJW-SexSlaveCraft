<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>SSC_Hediff_PetCat</defName>
    <label>宠物猫专精</label>
    <description>正在形成的宠物猫专精。偏向敏捷、闪避，以及对主人的亲昵依附。</description>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>成型中</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>灵巧</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <MoveSpeed>0.08</MoveSpeed>
          <MeleeDodgeChance>0.04</MeleeDodgeChance>
        </statOffsets>
      </li>
      <li>
        <label>难以捕捉</label>
        <minSeverity>0.5</minSeverity>
        <statOffsets>
          <MoveSpeed>0.16</MoveSpeed>
          <MeleeDodgeChance>0.08</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetCat_Final</defName>
    <label>终极宠物猫专精</label>
    <description>通过人格凝胶完成的终极宠物猫专精。该个体拥有高度闪避能力，并与主人亲昵行为高度适配。</description>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <MoveSpeed>0.22</MoveSpeed>
          <MeleeDodgeChance>0.12</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetDog</defName>
    <label>宠物狗专精</label>
    <description>正在形成的宠物狗专精。偏向动物处理、服从和动物训练互动。</description>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>成型中</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>服从</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <TameAnimalChance>0.08</TameAnimalChance>
          <TrainAnimalChance>0.08</TrainAnimalChance>
        </statOffsets>
      </li>
      <li>
        <label>兽栏调教完成</label>
        <minSeverity>0.5</minSeverity>
        <statOffsets>
          <TameAnimalChance>0.15</TameAnimalChance>
          <TrainAnimalChance>0.15</TrainAnimalChance>
        </statOffsets>
      </li>
      <li>
        <label>领群犬</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <TameAnimalChance>0.20</TameAnimalChance>
          <TrainAnimalChance>0.20</TrainAnimalChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetDog_Final</defName>
    <label>终极宠物狗专精</label>
    <description>通过人格凝胶完成的终极宠物狗专精。该个体高度适配动物处理和动物训练互动。</description>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <TameAnimalChance>0.25</TameAnimalChance>
          <TrainAnimalChance>0.25</TrainAnimalChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetRabbit</defName>
    <label>宠物兔专精</label>
    <description>正在形成的宠物兔专精。偏向 PNA 关联成长、生育模式、亲昵依附和轻敏捷。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_RabbitCloneSource" />
    </comps>
    <stages>
      <li>
        <label>成型中</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>轻快</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <MoveSpeed>0.06</MoveSpeed>
        </statOffsets>
        <statFactors>
          <RestRateMultiplier>1.05</RestRateMultiplier>
          <ImmunityGainSpeed>1.05</ImmunityGainSpeed>
        </statFactors>
      </li>
      <li>
        <label>温顺成型</label>
        <minSeverity>0.5</minSeverity>
        <statOffsets>
          <MoveSpeed>0.12</MoveSpeed>
        </statOffsets>
        <statFactors>
          <RestRateMultiplier>1.10</RestRateMultiplier>
          <ImmunityGainSpeed>1.10</ImmunityGainSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetRabbit_Final</defName>
    <label>终极宠物兔专精</label>
    <description>通过人格凝胶完成的终极宠物兔专精。该个体在 PNA 关联成长、生育模式、恢复和轻敏捷方面趋于稳定。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_RabbitCloneSource" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <MoveSpeed>0.18</MoveSpeed>
        </statOffsets>
        <statFactors>
          <RestRateMultiplier>1.15</RestRateMultiplier>
          <ImmunityGainSpeed>1.15</ImmunityGainSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_RabbitCloneLink</defName>
    <label>兔分身</label>
    <description>从宠物兔专精个体中分离出的分身。分身与本体共享休息和心情，快速成熟，且不能进行人格排泄。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_RabbitCloneLink" />
    </comps>
    <stages>
      <li>
        <label>成型中</label>
        <minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>成熟</label>
        <minSeverity>1</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_RabbitCloneLowPNA</defName>
    <label>兔分身 PNA 产出</label>
    <description>兔分身成熟后形成的低效 PNA 产出状态。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_RabbitClonePnaProduct">
        <spawnCount>3</spawnCount>
        <severityPerDay>0.08</severityPerDay>
        <nutritionPerDay>0.08</nutritionPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

</Defs>
