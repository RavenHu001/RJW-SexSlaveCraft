<Project Sdk="Microsoft.NET.Sdk">
  <!-- 使用实际 Waylith 编译器验证 GLSL，独立于 net9 模型门禁；不复制游戏依赖。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Waylith">
      <HintPath>$(GameRoot)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameRoot" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameRoot)/Waylith.dll')" Text="Set GameRoot to the target RimWorld 1.7 installation." />
  </Target>
</Project>
