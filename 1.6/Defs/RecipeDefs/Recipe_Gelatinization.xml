<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef>
    <defName>ApplyGelatinization</defName>
    <label>半凝胶化改造手术</label>
    <description>对肢体进行半凝胶化改造手术。手术会注入凝胶物质，随后身体会产生适应性反应。如果适应度先达到 100%，则成功改造为凝胶义肢；如果严重度先达到 100%，则肢体毁坏。</description>
    <workerClass>SexSlaveCraft.Recipe_ApplyGelatinization</workerClass>
    <jobString>进行半凝胶化改造手术</jobString>
    <workAmount>2500</workAmount>
    <skillRequirements>
      <Medicine>5</Medicine>
    </skillRequirements>
    <researchPrerequisite>SSC_RES_GelatinizationPartial</researchPrerequisite>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <addsHediff>Hediff_GelatinizationTemporary</addsHediff>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineIndustrial</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>MedicineIndustrial</li>
      </thingDefs>
    </defaultIngredientFilter>
    <anesthetize>true</anesthetize>
    <workSpeedStat>MedicalSurgerySuccessChance</workSpeedStat>
    <surgerySuccessChanceFactor>0.95</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0.05</deathOnFailedSurgeryChance>
  </RecipeDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>ApplyFullGelatinization</defName>
    <label>全凝胶化手术</label>
    <description>对已经完成人格排泄的身体执行全凝胶化手术。手术会让全身进入适应度与严重度的竞赛；若适应度先达到 100%，则完成全凝胶化；若严重度先达到 100%，目标将被彻底毁灭。</description>
    <workerClass>SexSlaveCraft.Recipe_ApplyFullGelatinization</workerClass>
    <jobString>进行全凝胶化手术</jobString>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <workAmount>5000</workAmount>
    <skillRequirements>
      <Medicine>10</Medicine>
    </skillRequirements>
    <researchPrerequisite>SSC_RES_GelatinizationFull</researchPrerequisite>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>MedicineIndustrial</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Purple_Aphrodisiac_Nanofluid_Plus</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>MedicineIndustrial</li>
        <li>Purple_Aphrodisiac_Nanofluid_Plus</li>
      </thingDefs>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>MedicineIndustrial</li>
        <li>Purple_Aphrodisiac_Nanofluid_Plus</li>
      </thingDefs>
    </defaultIngredientFilter>
    <anesthetize>true</anesthetize>
    <workSpeedStat>MedicalSurgerySuccessChance</workSpeedStat>
    <surgerySuccessChanceFactor>0.85</surgerySuccessChanceFactor>
    <deathOnFailedSurgeryChance>0.20</deathOnFailedSurgeryChance>
  </RecipeDef>
</Defs>
