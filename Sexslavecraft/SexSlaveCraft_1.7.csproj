  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameRoot)' == '' or !Exists('$(GameRoot)/Assembly-CSharp.dll')"
           Text="Set GameRoot to a RimWorld 1.7 installation containing Assembly-CSharp.dll at its root." />
    <Error Condition="!Exists('$(GameRoot)/UnityStubs.dll') or !Exists('$(GameRoot)/Waylith.dll')"
           Text="GameRoot must contain the RimWorld 1.7 Waylith reference assemblies." />
    <Error Condition="'$(RjwAssemblyPath)' == '' or !Exists('$(RjwAssemblyPath)')"
           Text="Set RjwAssemblyPath to the RJW DLL used by the target game environment." />
    <Error Condition="'$(AnimationsAssemblyPath)' == '' or !Exists('$(AnimationsAssemblyPath)')"
           Text="Set AnimationsAssemblyPath to the Rimworld-Animations DLL used by the target game environment." />
    <Error Condition="'$(GameHarmonyAssemblyPath)' == '' or !Exists('$(GameHarmonyAssemblyPath)')"
           Text="Set GameHarmonyAssemblyPath to the Harmony DLL used by the target game environment." />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
