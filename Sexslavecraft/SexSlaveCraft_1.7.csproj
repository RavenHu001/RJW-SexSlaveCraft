    <Compile Include="Comps/Comp_Train.Romance.cs" />
    <Compile Include="common/Romance/SSCRomanceCommandRecord.cs" />
    <Compile Include="common/Romance/SSCRomanceCommandGameComponent.cs" />
    <Compile Include="common/Romance/SSCRomanceCommandUtility.cs" />
    <Compile Include="common/Romance/SSCRomanceExecutionScope.cs" />
    <Compile Include="JobDriver/JobDriver_SSCRomanceCommand.cs" />
    <Compile Include="ThePatches/Harmony_RomanceCommand.cs" />
