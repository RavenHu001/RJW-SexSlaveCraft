<Project>
  <!-- Set intermediate paths before importing the SDK so the legacy project and
       the 1.7 project never share NuGet assets or generated source files. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>../.builds/build/1.7/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Sexslavecraft</RootNamespace>
    <AssemblyName>Sexslavecraft</AssemblyName>
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);SSC_RW17</DefineConstants>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRoot)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameRoot)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(GameRoot)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(GameRoot)/Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Maths">
      <HintPath>$(GameRoot)/Brutal.Core.Maths.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(GameRoot)/Brutal.Core.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RJW">
      <HintPath>$(RjwAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rimworld-Animations">
      <HintPath>$(AnimationsAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameHarmonyAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Keep one authoritative source list. Inactive legacy files stay inactive;
       adding a Compile item to the existing project includes it in this build. -->
  <Target Name="LoadLegacySourceItems" BeforeTargets="PrepareForBuild">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)/SexSlaveCraft_Alpha.csproj"
             Query="/*[local-name()='Project']/*[local-name()='ItemGroup']/*[local-name()='Compile']/@Include">
      <Output TaskParameter="Result" ItemName="LegacyCompile" />
    </XmlPeek>
    <Error Condition="'@(LegacyCompile)' == ''" Text="The shared legacy source list is empty." />
    <ItemGroup><Compile Include="@(LegacyCompile)" /></ItemGroup>
  </Target>
  <!-- AI 辅助生成：开关后端适配仅编入 1.7，保留旧版条件分支。 -->
  <ItemGroup>
    <Compile Include="common/Romance/SSCRomanceOldRelation.cs" />
    <Compile Include="common/Romance/SSCRomanceMoodData.cs" />
    <Compile Include="common/Romance/SSCRomanceMoodCatalog.cs" />
