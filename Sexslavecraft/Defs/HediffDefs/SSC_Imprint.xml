    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity><maxSeverity>1</maxSeverity>
    <stages><li>
      <statOffsets><PsychicSensitivity>0.5</PsychicSensitivity></statOffsets>
      <statFactors>
        <LifespanFactor>3</LifespanFactor><GlobalLearningFactor>1.5</GlobalLearningFactor>
        <ImmunityGainSpeed>1.5</ImmunityGainSpeed>
        <Vulnerability>0.25</Vulnerability><SexFrequency>1.25</SexFrequency><SexSatisfaction>1.25</SexSatisfaction>
