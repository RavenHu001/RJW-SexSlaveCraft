<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>SSC_HumanCattleLactationBridge</defName>
    <label>legacy lactation bridge marker</label>
    <description>Internal migration marker used to remove lactation shells created by an older SSC compatibility mode.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <everCurableByItem>false</everCurableByItem>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
      </li>
    </stages>
  </HediffDef>
</Defs>
