<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>SSC_Hediff_PetCat</defName>
    <label>宠物猫专精</label>
    <description>培养提高移动速度和狩猎隐蔽性。</description>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>成型中</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>灵巧</label>
        <minSeverity>0.2</minSeverity>
        <statFactors>
          <MoveSpeed>1.08</MoveSpeed>
          <HuntingStealth>1.40</HuntingStealth>
        </statFactors>
      </li>
      <li>
        <label>难以捕捉</label>
        <minSeverity>0.5</minSeverity>
        <statFactors>
          <MoveSpeed>1.16</MoveSpeed>
          <HuntingStealth>1.70</HuntingStealth>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetCat_Final</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>终极宠物猫专精</label>
    <description>提高移动速度和狩猎隐蔽性。解锁「贴心安抚」。</description>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <!-- 终极成果授予技能，与当前普通培养方向无关；移除成果时由既有组件回收技能。 -->
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_GiveAbility">
        <abilityDef>SSC_PetCatComfort</abilityDef>
        <minSeverity>0.01</minSeverity>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statFactors>
          <MoveSpeed>1.25</MoveSpeed>
          <HuntingStealth>2.00</HuntingStealth>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetDog</defName>
    <label>宠物狗专精</label>
    <description>培养提高动物驯服、训练成功率和种植速度。</description>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>成型中</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>服从</label>
        <minSeverity>0.2</minSeverity>
        <statOffsets>
          <TameAnimalChance>0.08</TameAnimalChance>
          <TrainAnimalChance>0.08</TrainAnimalChance>
        </statOffsets>
        <statFactors>
          <PlantWorkSpeed>1.10</PlantWorkSpeed>
        </statFactors>
      </li>
      <li>
        <label>兽栏调教完成</label>
        <minSeverity>0.5</minSeverity>
        <statOffsets>
          <TameAnimalChance>0.15</TameAnimalChance>
          <TrainAnimalChance>0.15</TrainAnimalChance>
        </statOffsets>
        <statFactors>
          <PlantWorkSpeed>1.20</PlantWorkSpeed>
        </statFactors>
      </li>
      <li>
        <label>领群犬</label>
        <minSeverity>0.8</minSeverity>
        <statOffsets>
          <TameAnimalChance>0.20</TameAnimalChance>
          <TrainAnimalChance>0.20</TrainAnimalChance>
        </statOffsets>
        <statFactors>
          <PlantWorkSpeed>1.30</PlantWorkSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetDog_Final</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>终极宠物狗专精</label>
    <description>提高动物驯服、训练成功率和种植速度。解锁「驯兽」。</description>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <!-- 新终极状态使用组件授予技能；已保存的普通 Hediff 实例由代码兼容授予，保留原实例。 -->
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_GiveAbility">
        <abilityDef>SSC_PetDogTame</abilityDef>
        <minSeverity>0.01</minSeverity>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <TameAnimalChance>0.25</TameAnimalChance>
          <TrainAnimalChance>0.25</TrainAnimalChance>
        </statOffsets>
        <statFactors>
          <PlantWorkSpeed>1.40</PlantWorkSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetRabbit</defName>
    <label>宠物兔专精</label>
    <description>培养提高清洁和烹饪速度。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>成型中</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>清洁熟练</label>
        <minSeverity>0.2</minSeverity>
        <statFactors>
          <CleaningSpeed>1.25</CleaningSpeed>
          <SSC_PetRabbitCookingFactor>1.15</SSC_PetRabbitCookingFactor>
        </statFactors>
      </li>
      <li>
        <label>家政熟练</label>
        <minSeverity>0.5</minSeverity>
        <statFactors>
          <CleaningSpeed>1.50</CleaningSpeed>
          <SSC_PetRabbitCookingFactor>1.30</SSC_PetRabbitCookingFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetRabbit_Final</defName>
    <label>终极宠物兔专精</label>
    <description>提高清洁和烹饪速度。解锁「精心料理」。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_GiveAbility">
        <compClass>SexSlaveCraft.HediffComp_PetRabbitCookingAbility</compClass>
        <abilityDef>SSC_PetRabbitCarefulCooking</abilityDef>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statFactors>
          <CleaningSpeed>1.70</CleaningSpeed>
          <SSC_PetRabbitCookingFactor>1.50</SSC_PetRabbitCookingFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetFox</defName>
    <label>宠物狐专精</label>
    <description>培养提高科研速度、包扎速度和包扎品质。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <label>成型中</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>研护熟练</label>
        <minSeverity>0.2</minSeverity>
        <statFactors>
          <ResearchSpeed>1.15</ResearchSpeed>
          <MedicalTendSpeed>1.15</MedicalTendSpeed>
          <MedicalTendQuality>1.05</MedicalTendQuality>
        </statFactors>
      </li>
      <li>
        <label>研护专精</label>
        <minSeverity>0.5</minSeverity>
        <statFactors>
          <ResearchSpeed>1.30</ResearchSpeed>
          <MedicalTendSpeed>1.30</MedicalTendSpeed>
          <MedicalTendQuality>1.10</MedicalTendQuality>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetFox_Final</defName>
    <label>终极宠物狐专精</label>
    <description>提高科研速度、包扎速度和包扎品质。解锁「应急包扎」。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_GiveAbility">
        <abilityDef>SSC_PetFoxEmergencyTend</abilityDef>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statFactors>
          <ResearchSpeed>1.50</ResearchSpeed>
          <MedicalTendSpeed>1.50</MedicalTendSpeed>
          <MedicalTendQuality>1.15</MedicalTendQuality>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_PetRabbitCarefulCooking</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>精心料理</label>
    <description>烹饪加快。合格餐食可避免因厨房卫生差或厨艺不足造成的食物中毒。</description>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <makesSickThought>false</makesSickThought>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>10000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <SSC_PetRabbitCookingFactor>1.50</SSC_PetRabbitCookingFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_RabbitCloneLink</defName>
    <label>兔分身</label>
    <description>从宠物兔专精个体中分离出的分身。分身与本体共享休息和心情，快速成熟，且不能进行人格排泄。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_RabbitCloneLink" />
    </comps>
    <stages>
      <li>
        <label>成型中</label>
        <minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>成熟</label>
        <minSeverity>1</minSeverity>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SSC_Hediff_RabbitCloneLowPNA</defName>
    <label>兔分身 PNA 产出</label>
    <description>兔分身成熟后形成的低效 PNA 产出状态。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="SexSlaveCraft.HediffCompProperties_RabbitClonePnaProduct">
        <spawnCount>3</spawnCount>
        <severityPerDay>0.08</severityPerDay>
        <nutritionPerDay>0.08</nutritionPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
      </li>
    </stages>
  </HediffDef>

</Defs>
