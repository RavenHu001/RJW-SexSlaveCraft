<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <SscSourceRoot Condition="'$(SscSourceRoot)' == ''">../../Sexslavecraft</SscSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SscSourceRoot)/common/SSCPnaMath.cs" Link="Production/SSCPnaMath.cs" />
    <Compile Include="$(SscSourceRoot)/common/SSCPnaExposureUtility.cs" Link="Production/SSCPnaExposureUtility.cs" />
    <Compile Include="$(SscSourceRoot)/common/SSCPnaGameComponent.cs" Link="Production/SSCPnaGameComponent.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffComp_SSCPnaLoad.cs" Link="Production/HediffComp_SSCPnaLoad.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffComp_SSCPnaRecovery.cs" Link="Production/HediffComp_SSCPnaRecovery.cs" />
    <Compile Include="$(SscSourceRoot)/common/IngestionOutcomeDoer_SSCPna.cs" Link="Production/IngestionOutcomeDoer_SSCPna.cs" />
    <Compile Include="$(SscSourceRoot)/DamageWorker/DamageWorker_PNA.cs" Link="Production/DamageWorker_PNA.cs" />
    <Compile Include="$(SscSourceRoot)/ThePatches/Harmony_SSCPna.cs" Link="Production/Harmony_SSCPna.cs" />
    <Compile Include="$(SscSourceRoot)/common/DebugActions_SSCPna.cs" Link="Production/DebugActions_SSCPna.cs" />
    <Reference Include="0Harmony"><HintPath>$(HarmonyAssemblyPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireHarmony" BeforeTargets="ResolveReferences" Condition="!Exists('$(HarmonyAssemblyPath)')">
    <Error Text="Supply -p:HarmonyAssemblyPath with the local net9.0 0Harmony.dll." />
  </Target>
</Project>
