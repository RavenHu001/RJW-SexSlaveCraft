<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 与统一门禁保持 net9.0 测试宿主；1.7 的 net10.0 实际游戏引用构建另行验证。 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <DefineConstants>$(DefineConstants);SSC_CSHARP</DefineConstants>
    <!-- 可指向隔离的修复前快照验证测试能捕获旧缺陷，默认始终链接当前生产源码。 -->
    <SscSourceRoot Condition="'$(SscSourceRoot)' == ''">../../Sexslavecraft</SscSourceRoot>
    <!-- 四组合宿主从编译结果中真正移除可选类型，避免仅关闭查找开关掩盖硬依赖。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <DefineConstants Condition="'$(SscAdapterMatrixOnly)' == 'true'">$(DefineConstants);SSC_ADAPTER_MATRIX</DefineConstants>
    <DefineConstants Condition="'$(SscMatrixFa)' == 'false'">$(DefineConstants);SSC_WITHOUT_FA</DefineConstants>
    <DefineConstants Condition="'$(SscMatrixSa)' == 'false'">$(DefineConstants);SSC_WITHOUT_SA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(SscAdapterMatrixOnly)' == 'true'">
    <Compile Remove="Program*.cs" />
    <Compile Include="Program.AdapterMatrixHost.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- 直接编译原生 Shader 的标量函数体；预处理仅提供 C# 类型外壳和 clamp 边界。 -->
    <Compile Include="../../1.7/Shaders/SSC/FullGelMath.glsl" Link="Production/FullGelMath.cs" />
    <!-- 过程类、四个组件、属性和终结检查均使用生产实现；只在 Stubs.cs 替代游戏边界。 -->
    <Compile Include="$(SscSourceRoot)/common/GelatinizationProcessUtility.cs" Link="Production/GelatinizationProcessUtility.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/Hediff_GelatinizationTemporary.cs" Link="Production/Hediff_GelatinizationTemporary.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/Hediff_FullGelatinizationTemporary.cs" Link="Production/Hediff_FullGelatinizationTemporary.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffComp_GelatinizationAdaptation.cs" Link="Production/HediffComp_GelatinizationAdaptation.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffComp_GelatinizationSeverity.cs" Link="Production/HediffComp_GelatinizationSeverity.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffComp_FullGelatinizationAdaptation.cs" Link="Production/HediffComp_FullGelatinizationAdaptation.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffComp_FullGelatinizationSeverity.cs" Link="Production/HediffComp_FullGelatinizationSeverity.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffCompProperties_GelatinizationAdaptation.cs" Link="Production/HediffCompProperties_GelatinizationAdaptation.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffCompProperties_GelatinizationSeverity.cs" Link="Production/HediffCompProperties_GelatinizationSeverity.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffCompProperties_FullGelatinizationAdaptation.cs" Link="Production/HediffCompProperties_FullGelatinizationAdaptation.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffCompProperties_FullGelatinizationSeverity.cs" Link="Production/HediffCompProperties_FullGelatinizationSeverity.cs" />
    <!-- 身体与 SizedApparel 两条入口使用同一个实际补丁，避免在测试内重写染色判断。 -->
    <Compile Include="$(SscSourceRoot)/ThePatches/Harmony_FullGelatinizationBodyTint.cs" Link="Production/Harmony_FullGelatinizationBodyTint.cs" />
    <Compile Include="$(SscSourceRoot)/ThePatches/Harmony_FullGelatinizationHeadTint.cs" Link="Production/Harmony_FullGelatinizationHeadTint.cs" />
    <Compile Include="$(SscSourceRoot)/ThePatches/FullGelVanillaEyeMask.cs" Link="Production/FullGelVanillaEyeMask.cs" />
    <Compile Include="$(SscSourceRoot)/common/FullGelAppearanceUtility.cs" Link="Production/FullGelAppearanceUtility.cs" />
    <Compile Include="$(SscSourceRoot)/common/FullGelAppearanceDraft.cs" Link="Production/FullGelAppearanceDraft.cs" />
    <Compile Include="$(SscSourceRoot)/common/Dialog_FullGelAppearance.cs" Link="Production/Dialog_FullGelAppearance.cs" />
    <Compile Include="$(SscSourceRoot)/common/SSCUIWidgets.cs" Link="Production/SSCUIWidgets.cs" />
    <Compile Include="$(SscSourceRoot)/ITab/ITab_SexSlaveTraining.GelAppearance.cs" Link="Production/ITab_GelAppearance.cs" />
    <Compile Include="$(SscSourceRoot)/ITab/ITab_SexSlaveTraining.IdentityControls.cs" Link="Production/ITab_IdentityControls.cs" />
    <Compile Include="$(SscSourceRoot)/common/SSCIdentityUtility.Trainer.cs" Link="Production/TrainerIdentity.cs" />
    <Compile Include="$(SscSourceRoot)/Hediff/HediffComp_FullGelAppearance.cs" Link="Production/HediffComp_FullGelAppearance.cs" />
  </ItemGroup>
  <PropertyGroup><DefineConstants>$(DefineConstants);SSC_ABILITY_TOGGLE_GEL</DefineConstants></PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/AbilityToggleBodyScribeBoundary.cs" Link="Boundary/AbilityToggleScribe.cs" />
    <Compile Include="../../Sexslavecraft/common/SSCBodyAbilityTogglePreferences.cs" Link="Production/SSCBodyAbilityTogglePreferences.cs" />
    <Compile Include="../../Sexslavecraft/common/SSCGelRenderingAbilityToggleBackend.cs" Link="Production/SSCGelRenderingAbilityToggleBackend.cs" />
    <Compile Include="../../Sexslavecraft/ITab/ITab_SexSlaveTraining.AbilityToggles.cs" Link="Production/AbilityToggleRows.cs" />
  </ItemGroup>
  <Import Project="../Shared/AbilityToggleProduction.targets" />
</Project>
