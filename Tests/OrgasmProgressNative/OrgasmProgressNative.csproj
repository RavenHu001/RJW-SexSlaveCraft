<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 标准 CLR 复用既有测试类型转发，模拟 Waylith 的旧 Unity 名称解析；不打包到 mod。 -->
    <ProjectReference Include="../CultureNative/UnityCoreShim/UnityCoreShim.csproj" />
    <Compile Include="../../Sexslavecraft/common/Orgasm/SSCOrgasmProgressUtility.cs" Link="Production/SSCOrgasmProgressUtility.cs" />
    <Compile Include="../../Sexslavecraft/common/Orgasm/SSCOrgasmProgressSampling.cs" Link="Production/SSCOrgasmProgressSampling.cs" />
    <Compile Include="../../Sexslavecraft/ThePatches/Harmony_OrgasmProgressSampling.cs" Link="Production/Harmony_OrgasmProgressSampling.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GameRoot)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(GameRoot)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith"><HintPath>$(GameRoot)/Waylith.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Waylith.UnityCompat"><HintPath>$(GameRoot)/Waylith.UnityCompat.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Core.Maths"><HintPath>$(GameRoot)/Brutal.Core.Maths.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Core.Numerics"><HintPath>$(GameRoot)/Brutal.Core.Numerics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RJW"><HintPath>$(RjwAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Rimworld-Animations"><HintPath>$(AnimationsAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameHarmonyAssemblyPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameRoot)/Assembly-CSharp.dll') or !Exists('$(RjwAssemblyPath)') or !Exists('$(AnimationsAssemblyPath)') or !Exists('$(GameHarmonyAssemblyPath)')"
           Text="Supply actual 1.7 GameRoot, RjwAssemblyPath, AnimationsAssemblyPath and GameHarmonyAssemblyPath." />
  </Target>
</Project>
