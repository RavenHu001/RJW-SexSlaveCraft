    <Compile Include="../../Sexslavecraft/DamageWorker/Verb_MeleeAttackSSCPnaWhip.cs" Link="Production/Verb_MeleeAttackSSCPnaWhip.cs" />
    <Compile Include="../../Sexslavecraft/ThePatches/Harmony_SSCPnaWhip.cs" Link="Production/Harmony_SSCPnaWhip.cs" />
    <Compile Include="../../Sexslavecraft/ThePatches/Harmony_SSCPnaSpearGlow.cs" Link="Production/Harmony_SSCPnaSpearGlow.cs" />
