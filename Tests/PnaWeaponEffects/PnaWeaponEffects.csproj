<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Sexslavecraft/common/SSCPnaMath.cs" Link="Production/SSCPnaMath.cs" />
    <Compile Include="../../Sexslavecraft/common/SSCPnaWeaponEffectsUtility.cs" Link="Production/SSCPnaWeaponEffectsUtility.cs" />
    <Compile Include="../../Sexslavecraft/common/SSCPnaSpearGlowUtility.cs" Link="Production/SSCPnaSpearGlowUtility.cs" />
