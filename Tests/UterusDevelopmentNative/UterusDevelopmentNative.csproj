<Project Sdk="Microsoft.NET.Sdk">
  <!-- AI 辅助生成：实际 1.7 类型、生产程序集和 XML，不复制被测逻辑。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <BuildInParallel>false</BuildInParallel><RestoreBuildInParallel>false</RestoreBuildInParallel>
  </PropertyGroup>
  <ItemGroup>
    <!-- 当前游戏 Harmony3 与完整候选一致，通过友元访问真实补丁，不重复编译内部类型。 -->
    <ProjectReference Include="../CultureNative/UnityCoreShim/UnityCoreShim.csproj" />
    <!-- 可显式验证隔离候选 DLL，避免专项构建覆盖仓库正式产物。 -->
    <ProjectReference Include="../../Sexslavecraft/SexSlaveCraft_1.7.csproj" Condition="'$(SscAssemblyPath)' == ''" />
    <Reference Include="Sexslavecraft" Condition="'$(SscAssemblyPath)' != ''"><HintPath>$(SscAssemblyPath)</HintPath><Private>true</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameRoot)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(GameRoot)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RJW"><HintPath>$(RjwAssemblyPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath Condition="'$(GameHarmonyAssemblyPath)' != ''">$(GameHarmonyAssemblyPath)</HintPath><HintPath Condition="'$(GameHarmonyAssemblyPath)' == ''">$(HarmonyAssemblyPath)</HintPath></Reference>
  </ItemGroup>
</Project>
