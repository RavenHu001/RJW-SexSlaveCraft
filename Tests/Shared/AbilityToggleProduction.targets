<Project>
  <!-- 模型宿主可单独启用 1.7 身体过滤；只注册显式链接的载体，实际生产仍注册全部五项。 -->
  <PropertyGroup><DefineConstants>$(DefineConstants);SSC_ABILITY_TOGGLE_FRAMEWORK;SSC_ABILITY_TOGGLE_SCOPED_TEST</DefineConstants></PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../Sexslavecraft/common/SSCAbilityToggleFramework.cs" Link="Production/SSCAbilityToggleFramework.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../Sexslavecraft/common/SSCAbilityToggleState.cs" Link="Production/SSCAbilityToggleState.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../Sexslavecraft/common/SSCAbilityToggleUtility.cs" Link="Production/SSCAbilityToggleUtility.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../Sexslavecraft/common/SSCPersonalityRuntimeUtility.cs" Link="Production/SSCPersonalityRuntimeUtility.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../Sexslavecraft/Comps/Comp_AbilityToggles.cs" Link="Production/Comp_AbilityToggles.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../Sexslavecraft/Hediff/Hediff_SSCToggleAbilityMarker.cs" Link="Production/Hediff_SSCToggleAbilityMarker.cs" />
  </ItemGroup>
</Project>
