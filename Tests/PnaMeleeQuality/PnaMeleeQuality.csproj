<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Sexslavecraft/ThePatches/Harmony_SSCPnaMeleeQuality.cs" Link="Production/Harmony_SSCPnaMeleeQuality.cs" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GameRoot)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityStubs"><HintPath>$(GameRoot)/UnityStubs.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyAssemblyPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameRoot)/Assembly-CSharp.dll')" Text="Supply GameRoot for the actual RimWorld 1.7 installation." />
    <Error Condition="!Exists('$(HarmonyAssemblyPath)')" Text="Supply HarmonyAssemblyPath for the local net9.0 test Harmony." />
  </Target>
</Project>
