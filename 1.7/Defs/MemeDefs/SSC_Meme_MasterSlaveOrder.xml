<?xml version="1.0" encoding="utf-8"?>
<!-- AI 辅助生成；1.7 主奴秩序挂载、命名与背景段落；具体文案使用可检索占位，不添加行为拦截。 -->
<Defs>
  <!-- 模因分组仅控制界面排布；各顶层定义独立门控，分组本身不建立模因互斥。 -->
  <MemeGroupDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSC_MasterSlaveOrder</defName>
    <drawOffset>(0.15, 0.57)</drawOffset>
    <maxRows>1</maxRows>
    <renderOrder>2600</renderOrder>
  </MemeGroupDef>
  <!-- 普通类别的最高影响三级模因；随机因子仍为原版权重乘数，不表示固定生成概率，不新增 exclusionTags。 -->
  <MemeDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSC_Meme_MasterSlaveOrder</defName>
    <label>主奴秩序</label>
    <description>[TODO:SSC_Meme_MasterSlaveOrder.description]</description>
    <!-- 1.7 专属透明图标：金色权杖、银灰短链、棕黑平涂项圈及深紫爱心拉环；沿用原版模因绘制。 -->
    <iconPath>UI/Memes/SSC_MasterSlaveOrder</iconPath>
    <groupDef>SSC_MasterSlaveOrder</groupDef>
    <category>Normal</category>
    <impact>3</impact>
    <randomizationSelectionWeightFactor>1</randomizationSelectionWeightFactor>
    <!-- 三个原生命名包参与来源选择；保留结构模因覆盖、神祇来源与已用包回退，不强制选中 SSC。 -->
    <symbolPacks>
      <li>
        <ideoName>SSCNAMETODO01</ideoName>
        <theme>SSCTHEMETODO01</theme>
        <adjective>SSCADJTODO01</adjective>
        <member>SSCMEMBERTODO01</member>
      </li>
      <li>
        <ideoName>SSCNAMETODO02</ideoName>
        <theme>SSCTHEMETODO02</theme>
        <adjective>SSCADJTODO02</adjective>
        <member>SSCMEMBERTODO02</member>
      </li>
      <li>
        <ideoName>SSCNAMETODO03</ideoName>
        <theme>SSCTHEMETODO03</theme>
        <adjective>SSCADJTODO03</adjective>
        <member>SSCMEMBERTODO03</member>
      </li>
    </symbolPacks>
    <!-- 原版按当前模因收集共用规则；固定索引供四语注入，字面占位不能写成方括号子规则。 -->
    <generalRules>
      <rulesStrings>
        <!-- 0～2：文化组合词；不覆盖全局文化命名器。 -->
        <li>memeAdjective->SSCADJTODO</li>
        <li>memeCreed->SSCCREEDTODO</li>
        <li>memeHyphenPrefix->SSCPREFIXTODO</li>
        <!-- 3：领袖独立入口；优先级控制选择，同一原版结果用于男女称谓。 -->
        <li>r_leaderTitle(priority=10)->[SSC_LeaderPreset]</li>
        <!-- 4～6：领袖候选。沿用原版名称生成、手工锁名及唯一性规则。 -->
        <li>SSC_LeaderPreset->SSCLEADERTODO01</li>
        <li>SSC_LeaderPreset->SSCLEADERTODO02</li>
        <li>SSC_LeaderPreset->SSCLEADERTODO03</li>
        <!-- 7～9：仅专用道德导师命名器引用；不在模因中定义通用职位根规则。 -->
        <li>SSC_MoralistPreset->SSCMORALTODO01</li>
        <li>SSC_MoralistPreset->SSCMORALTODO02</li>
        <li>SSC_MoralistPreset->SSCMORALTODO03</li>
        <!-- 10～12：仅 SSC 契约仪式命名器引用；无模因时子规则缺失，由原命名器兜底。 -->
        <li>SSC_BindingRitualPreset->SSCRITUALTODO01</li>
        <li>SSC_BindingRitualPreset->SSCRITUALTODO02</li>
        <li>SSC_BindingRitualPreset->SSCRITUALTODO03</li>
      </rulesStrings>
    </generalRules>
    <!-- 只提供当前模因的背景段落，不增加 patterns；继续由原版结构选择六类故事框架。
         meme_ 分组参与原版段落偏好，允许多模因混合；移除模因不清洗历史描述或解除描述锁定。 -->
    <descriptionMaker>
      <rules>
        <rulesStrings>
          <!-- 0～1：TheistMyth；重复 episode 单条最多一次，其他位置由原版候选补足。 -->
          <li>creation(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO01</li>
          <li>episode(uses=1,tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO02</li>
          <!-- 2～5：TheistFounder。 -->
          <li>intro(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO03</li>
          <li>conflict(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO04</li>
          <li>founderJoin(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO05</li>
          <li>victory(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO06</li>
          <!-- 6～7：IdeologicalFounder；同一 story 不在两个位置重复使用。 -->
          <li>setup(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO07</li>
          <li>story(uses=1,tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO08</li>
          <!-- 8～10：IdeologicalLesson。 -->
          <li>lessonIntro(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO09</li>
          <li>lesson(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO10</li>
          <li>lessonReinforcement(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO11</li>
          <!-- 11～13：ArchistDescription。 -->
          <li>archistBasis(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO12</li>
          <li>archistFact(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO13</li>
          <li>archistProphecy(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO14</li>
          <!-- 14～16：AnimistDescription。 -->
          <li>animistBasis(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO15</li>
          <li>animistFact(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO16</li>
          <li>animistProphecy(tag=meme_SSC_MasterSlaveOrder)->SSCDESCTODO17</li>
        </rulesStrings>
      </rules>
    </descriptionMaker>
    <!-- 五个同 Issue 必选组同时约束生成与手选替代范围；不新增模因间排斥标签。 -->
    <requireOne>
      <!-- 性奴态度：允许尊重、神圣、艳羡，正权重默认来自神圣档。 -->
      <li>
        <li>SSC_Precept_SexSlave_Respect</li>
        <li>SSC_Precept_SexSlave_Sacred</li>
        <li>SSC_Precept_SexSlave_Envy</li>
      </li>
      <!-- 训导官态度：保留全部五档供手选，正权重默认来自神职档。 -->
      <li>
        <li>SSC_Precept_Trainer_Hostile</li>
        <li>SSC_Precept_Trainer_Revulsion</li>
        <li>SSC_Precept_Trainer_Indifference</li>
        <li>SSC_Precept_Trainer_Reverence</li>
        <li>SSC_Precept_Trainer_SacredOffice</li>
      </li>
      <!-- 主人态度：允许敬重与神圣主人，正权重默认来自神圣主人档。 -->
      <li>
        <li>SSC_Precept_Master_Deference</li>
        <li>SSC_Precept_Master_HolyMaster</li>
      </li>
      <!-- 主人数量：三档均可替代，生成默认三主以内；不在定义层强制人口上限。 -->
      <li>
        <li>SSC_Precept_MasterCount_One</li>
        <li>SSC_Precept_MasterCount_Three</li>
        <li>SSC_Precept_MasterCount_Unlimited</li>
      </li>
      <!-- 个人性奴数量：三档均可替代，生成默认三奴以内；不拦截绑定或身份操作。 -->
      <li>
        <li>SSC_Precept_SlaveCount_One</li>
        <li>SSC_Precept_SlaveCount_Three</li>
        <li>SSC_Precept_SlaveCount_Unlimited</li>
      </li>
      <!-- 第六组独立议题：六档均可手选，仅性别不限有生成权重。 -->
      <li>
        <li>SSC_Precept_SlaveGender_FemaleOnly</li>
        <li>SSC_Precept_SlaveGender_MaleOnly</li>
        <li>SSC_Precept_SlaveGender_Unrestricted</li>
        <li>SSC_Precept_SlaveGender_FemaleRequired</li>
        <li>SSC_Precept_SlaveGender_MaleRequired</li>
        <li>SSC_Precept_SlaveGender_NonMasterRequired</li>
      </li>
    </requireOne>
  </MemeDef>
</Defs>
