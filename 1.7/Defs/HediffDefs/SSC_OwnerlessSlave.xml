<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>SSC_Hediff_OwnerlessSlave</defName>
    <hediffClass>SexSlaveCraft.Hediff_SSCOwnerlessSlave</hediffClass>
    <label>无主性奴</label>
    <description>记录无主性奴的性奴化进度。</description>
    <isBad>false</isBad>
    <!-- 阶段记录由 SSC 的成形或交接入口建立。原版复制不继承此记录。 -->
    <duplicationAllowed>false</duplicationAllowed>
    <!-- 20% 是新成形的默认进度。已有进度的交接应传入原严重度。 -->
    <initialSeverity>0.2</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <!-- 正阈值与锁链一致，依次供玩法阶段、健康页和调教管理刻度使用。 -->
    <stages>
      <li><minSeverity>0.1</minSeverity><label>一阶</label></li>
      <li><minSeverity>0.3</minSeverity><label>二阶</label></li>
      <li><minSeverity>0.5</minSeverity><label>三阶</label></li>
      <li><minSeverity>0.9</minSeverity><label>四阶</label></li>
    </stages>
  </HediffDef>
</Defs>
