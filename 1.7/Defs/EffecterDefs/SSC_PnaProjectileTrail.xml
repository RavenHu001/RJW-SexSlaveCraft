      <li>
        <scaleAmt>1</scaleAmt>
        <scaleTime>0.14</scaleTime>
        <axisMask>(1,0,0)</axisMask>
        <curve>
          <points>
            <li>(0,0)</li>
            <li>(0.15,-0.05)</li>
            <li>(0.6,-0.5)</li>
            <li>(1,-0.95)</li>
          </points>
        </curve>
      </li>
    </scalers>
  </FleckDef>
</Defs>
