      </li>
      <li Class="PreceptComp_SituationalThought">
        <thought>SSC_Culture_Master_Revulsion_Leader</thought>
      </li>
    </comps>
  </PreceptDef>
  <!-- 普通文化低档：defaultSelectionWeight=7；必选组抽取权重为零。与主模因冲突，加入主模因时由原版兼容性维护替换。 反馈数值由步骤 2 挂载的 ThoughtDef 保存，顺序和重要度不换算数值。 -->
  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSC_Precept_Master_Indifference</defName>
