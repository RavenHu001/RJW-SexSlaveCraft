<?xml version="1.0" encoding="utf-8"?>
<!-- AI 辅助生成；1.7 步骤 1。两类权重显式配置；反馈 comps 随后续真实 workers 接入。
     description 为交接占位，不是正式文案；不使用意愿/历史事件组件。 -->
<Defs>
  <!-- 同一议题仅允许一个档位；顶层 Ideology 门控避免未启用文化 DLC 时装载本组定义。 -->
  <IssueDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSC_Issue_Trainer</defName>
    <label>训导官</label>
    <iconPath>UI/Issues/Slavery</iconPath>
    <allowMultiplePrecepts>false</allowMultiplePrecepts>
  </IssueDef>
  <!-- 普通文化低档：defaultSelectionWeight=1；必选组抽取权重为零。不与主模因冲突，已有合法选择在改革时可保留。 显示顺序和重要度不代替后续反馈机制。 -->
  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSC_Precept_Trainer_Hostile</defName>
    <issue>SSC_Issue_Trainer</issue>
    <label>敌视</label>
    <description>[TODO:SSC_Precept_Trainer_Hostile.description]</description>
    <impact>Low</impact>
    <displayOrderInIssue>10</displayOrderInIssue>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>true</countsTowardsPreceptLimit>
    <selectionWeight>0</selectionWeight>
    <defaultSelectionWeight>1</defaultSelectionWeight>
  </PreceptDef>
  <!-- 普通文化低档：defaultSelectionWeight=2；必选组抽取权重为零。不与主模因冲突，已有合法选择在改革时可保留。 显示顺序和重要度不代替后续反馈机制。 -->
  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSC_Precept_Trainer_Revulsion</defName>
    <issue>SSC_Issue_Trainer</issue>
    <label>厌恶</label>
    <description>[TODO:SSC_Precept_Trainer_Revulsion.description]</description>
    <impact>Low</impact>
    <displayOrderInIssue>20</displayOrderInIssue>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>true</countsTowardsPreceptLimit>
    <selectionWeight>0</selectionWeight>
    <defaultSelectionWeight>2</defaultSelectionWeight>
  </PreceptDef>
  <!-- 普通文化低档：defaultSelectionWeight=7；必选组抽取权重为零。不与主模因冲突，已有合法选择在改革时可保留。 显示顺序和重要度不代替后续反馈机制。 -->
  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSC_Precept_Trainer_Indifference</defName>
    <issue>SSC_Issue_Trainer</issue>
    <label>漠视</label>
    <description>[TODO:SSC_Precept_Trainer_Indifference.description]</description>
    <impact>Low</impact>
    <displayOrderInIssue>30</displayOrderInIssue>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>true</countsTowardsPreceptLimit>
    <selectionWeight>0</selectionWeight>
    <defaultSelectionWeight>7</defaultSelectionWeight>
  </PreceptDef>
  <!-- 两类生成权重均为零，仅供手选或保留已有合法选择；associatedMemes 仅关联，不作前置门槛。 显示顺序和重要度不代替后续反馈机制。 -->
  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSC_Precept_Trainer_Reverence</defName>
    <issue>SSC_Issue_Trainer</issue>
    <label>尊敬</label>
    <description>[TODO:SSC_Precept_Trainer_Reverence.description]</description>
    <impact>Medium</impact>
    <displayOrderInIssue>40</displayOrderInIssue>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>true</countsTowardsPreceptLimit>
    <selectionWeight>0</selectionWeight>
    <defaultSelectionWeight>0</defaultSelectionWeight>
    <associatedMemes><li>SSC_Meme_MasterSlaveOrder</li></associatedMemes>
  </PreceptDef>
  <!-- 主模因专属默认：必选组 selectionWeight=1，普通默认权重为零；requiredMemes 限定资格。 显示顺序和重要度不代替后续反馈机制。 -->
  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>SSC_Precept_Trainer_SacredOffice</defName>
    <issue>SSC_Issue_Trainer</issue>
    <label>圣职</label>
    <description>[TODO:SSC_Precept_Trainer_SacredOffice.description]</description>
    <impact>High</impact>
    <displayOrderInIssue>50</displayOrderInIssue>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>true</countsTowardsPreceptLimit>
    <selectionWeight>1</selectionWeight>
    <defaultSelectionWeight>0</defaultSelectionWeight>
    <requiredMemes><li>SSC_Meme_MasterSlaveOrder</li></requiredMemes>
    <associatedMemes><li>SSC_Meme_MasterSlaveOrder</li></associatedMemes>
  </PreceptDef>
</Defs>
