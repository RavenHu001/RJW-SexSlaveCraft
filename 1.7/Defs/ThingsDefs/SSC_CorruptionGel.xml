<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 1.7第三步：原生单份服用、非成瘾药品；专用美术暂用既有人格凝胶图。 -->
  <ThingDef ParentName="ResourceBase">
    <defName>SSC_CorruptionGel</defName><label>depravity gel</label>
    <description>A gel carrying fragments of experience rather than a complete personality. Ingesting it induces a lingering euphoria and slight distraction. Another dose refreshes the duration without strengthening the effect. SSC masters are immune.</description>
    <graphicData><texPath>Things/Item/PersonalitySlime</texPath><graphicClass>Graphic_Single</graphicClass><color>(0.75, 0.4, 0.8)</color></graphicData>
    <stackLimit>75</stackLimit><healthAffectsPrice>false</healthAffectsPrice><tradeability>Sellable</tradeability>
    <statBases><MarketValue>125</MarketValue><Mass>0.05</Mass><Flammability>0.2</Flammability><DeteriorationRate>2</DeteriorationRate></statBases>
    <thingCategories><li>Drugs</li></thingCategories>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <defaultNumToIngestAtOnce>1</defaultNumToIngestAtOnce><maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <foodType>Processed, Fluid</foodType><humanlikeOnly>true</humanlikeOnly>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
      <drugCategory>Medical</drugCategory><ingestEffect>EatVegetarian</ingestEffect><ingestSound>Meal_Eat</ingestSound>
      <outcomeDoers>
        <li Class="SexSlaveCraft.IngestionOutcomeDoer_SSCCorruptionGel"><effect>SSC_Hediff_CorruptionGelEffect</effect></li>
      </outcomeDoers>
    </ingestible>
    <!-- 无ChemicalDef、成瘾或过量；保留原生药品政策与服用流程。 -->
    <comps><li Class="CompProperties_Drug"><addictiveness>0</addictiveness><listOrder>1010</listOrder></li></comps>
  </ThingDef>
</Defs>
